# Static file server for the built site. TLS and host routing are handled by the
# proxy in front of this container, so Caddy only listens on plain :80.
{
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# Everything comes from this server: no scripts, fonts or images from elsewhere.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Every page is a file of its own: /faq is faq.html, /catalogue/tools/git is catalogue/tools/git.html.
	redir /index.html / 301
	@trailing path_regexp trailing ^(.+)/$
	redir @trailing {re.trailing.1} 301
	try_files {path} {path}.html
	file_server

	handle_errors {
		@notfound expression `{err.status_code} == 404`
		handle @notfound {
			rewrite * /404.html
			file_server
		}
	}
}
