# Static file server for the built site. TLS and host routing are handled by the
# proxy in front of this container, so Caddy only listens on plain :80.
{
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# Everything comes from this server: no scripts, fonts or images from elsewhere.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# One page for every address: the app shows the right content, or "not found".
	try_files {path} /index.html
	file_server
}
